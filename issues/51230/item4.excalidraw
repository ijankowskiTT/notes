      "seed": 216176799,
      "version": 1,
      "versionNonce": 613552597,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789636770582,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "dfb_fusion  =  dfb::xmm     // \u201cstream gamma/beta\u201d\ndfb_ex_sqr   =  dfb::x       // E[x]\u00b2 scratch, reused as scale staging\n\nlayer_norm:  dfb_xmm = dfb::xmm   \u2192  fusion and xmm are THE SAME FIFO\nRMSNORM:     dfb_xmm = in0        \u2192  fusion is a separate buffer",
      "originalText": "dfb_fusion  =  dfb::xmm     // \u201cstream gamma/beta\u201d\ndfb_ex_sqr   =  dfb::x       // E[x]\u00b2 scratch, reused as scale staging\n\nlayer_norm:  dfb_xmm = dfb::xmm   \u2192  fusion and xmm are THE SAME FIFO\nRMSNORM:     dfb_xmm = in0        \u2192  fusion is a separate buffer",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.3
    },
    {
      "id": "el-760978629",
      "x": 996,
      "y": 778,
      "width": 694.1399999999999,
      "height": 33.800000000000004,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 989100073,
      "version": 1,
      "versionNonce": 531321737,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789636770582,
      "link": null,
      "locked": false,
      "type": "text",
      "text": "That alias is why packing scale into fusion (the issue one-liner) is unsafe for layer_norm:\nxmm is still full of (x\u2212mean) when scale would reserve_back on fusion.",
      "originalText": "That alias is why packing scale into fusion (the issue one-liner) is unsafe for layer_norm:\nxmm is still full of (x\u2212mean) when scale would reserve_back on fusion.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.3
    },
